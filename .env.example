# Lingxi Workbench Server 环境变量示例
#
# 所有变量均有默认值（见各模块 application.yml），默认值与本仓库
# resources/docker/compose.yml 启动的本地容器对齐：clone 后先执行
# ./scripts/dev-start.sh 和 ./scripts/init-db.sh，无需配置即可启动。
# 仅在覆盖默认部署（远程数据库、生产环境等）时复制为 .env 并修改。

# ---------- 数据库（默认指向 compose 的本地 PostgreSQL） ----------
# LINGXI_DB_URL=jdbc:postgresql://localhost:5432/lingxi
# LINGXI_DB_USERNAME=lingxi
# LINGXI_DB_PASSWORD=lingxi

# ---------- Redis（默认无密码） ----------
# LINGXI_REDIS_HOST=localhost
# LINGXI_REDIS_PORT=6379
# LINGXI_REDIS_PASSWORD=

# ---------- RocketMQ ----------
# LINGXI_ROCKETMQ_NAMESRV=localhost:9876

# ---------- 对象存储（MinIO） ----------
# LINGXI_STORAGE_MINIO_ENDPOINT=http://localhost:9000
# LINGXI_STORAGE_MINIO_ACCESS_KEY=lingxi
# LINGXI_STORAGE_MINIO_SECRET_KEY=lingxi-minio-dev

# ---------- 服务间内部调用（admin -> application，两服务需一致） ----------
# LINGXI_INTERNAL_OPS_TOKEN=lingxi-dev-internal-ops-token
# LINGXI_APPLICATION_BASE_URL=http://127.0.0.1:8080

# ---------- 观测（可选：Langfuse / OTLP 链路追踪） ----------
# LINGXI_LANGFUSE_API_ENABLED=false
# LINGXI_LANGFUSE_BASE_URL=
# LINGXI_LANGFUSE_PUBLIC_KEY=
# LINGXI_LANGFUSE_SECRET_KEY=
