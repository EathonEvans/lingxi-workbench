<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lingxi.ai</groupId>
        <artifactId>lingxi-workbench-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mcp-server</artifactId>
    <name>Lingxi MCP Server</name>

    <dependencies>
        <dependency>
            <groupId>com.lingxi.ai</groupId>
            <artifactId>infra-ai</artifactId>
            <!--
                当前仅复用 infra-ai 的纯 Tool 契约与执行器；MCP 进程不需要
                framework 中的数据源、Redis、Sa-Token、MyBatis 和 RocketMQ。
            -->
            <exclusions>
                <exclusion>
                    <groupId>com.lingxi.ai</groupId>
                    <artifactId>framework</artifactId>
                </exclusion>
                <!-- MCP Server 仅保留 Spring AI Server SDK，禁止随 infra-ai 带入 AgentScope MCP Client SDK。 -->
                <exclusion>
                    <groupId>io.agentscope</groupId>
                    <artifactId>agentscope-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.lingxi.ai</groupId>
            <artifactId>framework</artifactId>
            <!-- MCP 仅复用统一 Gson JSON 契约；排除 Framework 的数据源、缓存、鉴权与消息依赖。 -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
